rules_version = '2';
// ACTA Members Portal — Firestore security rules.
// Paste this into Firebase Console → Firestore Database → Rules, then click Publish.
// Roles: admins/{uid}.role == "founder" or "admin" (full access, final approval) or "coordinator" (endorses, posts updates).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function adminDoc() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    function isAdmin()   { return signedIn() && exists(adminDoc()); }
    function isFounder() { return isAdmin() && get(adminDoc()).data.role in ['founder', 'admin']; }
    function isMember()  { return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() <= max; }

    // Admin list. Added by hand in the Firebase Console (document ID = the person's User UID).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Member registry used by "Verify ID". Anyone can look up ONE ID. Only the Founder can add or change members.
    match /registry/{idNo} {
      allow get: if true;
      allow list: if isMember() || isAdmin();
      allow write: if isFounder();
    }

    // Private member profiles. Member sees and edits own contact details and can submit a photo for approval; only Founder/Admin grants or changes membership.
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isFounder();
      allow update: if isFounder()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'emergencyContact', 'pendingPhoto', 'pendingPhotoAt'])
            && (!('pendingPhoto' in request.resource.data) || (str(request.resource.data.pendingPhoto, 200000)
                && (request.resource.data.pendingPhoto.size() == 0 || request.resource.data.pendingPhoto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))))
            && str(request.resource.data.phone, 30)
            && str(request.resource.data.address, 200)
            && str(request.resource.data.emergencyContact, 200));
    }

    // Portal account requests from existing members, waiting for the Founder's approval.
    match /signups/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'idNo', 'chapter', 'email', 'createdAt'])
        && str(request.resource.data.name, 120)
        && str(request.resource.data.idNo, 30)
        && str(request.resource.data.chapter, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow delete: if isFounder();
      allow update: if false;
    }

    // Announcements and resources: "public" ones for everyone, "members" ones after login. Any admin can post.
    match /announcements/{id} {
      allow read: if resource.data.audience == 'public' || isMember() || isAdmin();
      allow write: if isAdmin();
    }
    match /resources/{id} {
      allow read: if resource.data.audience == 'public' || isMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Membership applications (official form). Anyone can submit; admins review.
    // Coordinator can mark contacted / endorsed. Only the Founder can approve, decline or delete.
    function validApplication(d) {
      return d.keys().hasOnly(['firstName', 'nickname', 'middleName', 'lastName', 'birthPlace', 'birthdate', 'civilStatus', 'height', 'weight', 'citizenship', 'religion', 'bloodType', 'street', 'barangay', 'city', 'province', 'zip', 'telephone', 'phone', 'email', 'chapter', 'employer', 'employerAddress', 'jobTitle', 'workTel', 'workFax', 'spouseName', 'spouseBirthdate', 'elementary', 'elementaryYear', 'highSchool', 'highSchoolYear', 'college', 'collegeYear', 'course', 'hobbies', 'skills', 'sponsorName', 'children', 'photo', 'status', 'consent', 'createdAt'])
        && str(d.firstName, 60)
        && str(d.nickname, 40)
        && str(d.middleName, 60)
        && str(d.lastName, 60)
        && str(d.birthPlace, 120)
        && str(d.birthdate, 10)
        && str(d.civilStatus, 20)
        && str(d.height, 20)
        && str(d.weight, 20)
        && str(d.citizenship, 40)
        && str(d.religion, 60)
        && str(d.bloodType, 10)
        && str(d.street, 120)
        && str(d.barangay, 80)
        && str(d.city, 80)
        && str(d.province, 80)
        && str(d.zip, 10)
        && str(d.telephone, 30)
        && str(d.phone, 30)
        && str(d.email, 120)
        && str(d.chapter, 80)
        && str(d.employer, 120)
        && str(d.employerAddress, 200)
        && str(d.jobTitle, 80)
        && str(d.workTel, 30)
        && str(d.workFax, 30)
        && str(d.spouseName, 120)
        && str(d.spouseBirthdate, 10)
        && str(d.elementary, 120)
        && str(d.elementaryYear, 20)
        && str(d.highSchool, 120)
        && str(d.highSchoolYear, 20)
        && str(d.college, 120)
        && str(d.collegeYear, 20)
        && str(d.course, 120)
        && str(d.hobbies, 200)
        && str(d.skills, 200)
        && str(d.sponsorName, 120)
        && d.firstName.size() > 0
        && d.lastName.size() > 0
        && d.birthPlace.size() > 0
        && d.birthdate.size() > 0
        && d.civilStatus.size() > 0
        && d.citizenship.size() > 0
        && d.barangay.size() > 0
        && d.city.size() > 0
        && d.province.size() > 0
        && d.phone.size() > 0
        && d.chapter.size() > 0
        && d.children is list && d.children.size() <= 8
        && str(d.photo, 200000)
        && (d.photo.size() == 0 || d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
        && d.status == 'new'
        && d.consent == true
        && d.createdAt == request.time;
    }
    match /applications/{id} {
      allow create: if validApplication(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endorsedBy', 'endorsedAt', 'decidedBy', 'decidedAt'])
        && (isFounder() || request.resource.data.status in ['new', 'contacted', 'endorsed']);
      allow delete: if isFounder();
    }
  }
}
